<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>NH5AiSkillAdjustment</RootNamespace>
    <AssemblyName>NH5AiSkillAdjustment</AssemblyName>
    <Product>NH5 AI Skill Adjustment Tool</Product>
    <AssemblyTitle>NH5 AI Skill Adjustment Tool</AssemblyTitle>
    <Description>Local NASCAR Heat 5 AI skill slider. 100% = vanilla pace, 200% = double. Forces native 105.</Description>
    <Version>1.0.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
